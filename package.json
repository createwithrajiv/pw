{
  "name": "rajiv-yadav-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Premium personal portfolio for Rajiv Yadav — AI Engineer. Data-driven from src/data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run seo:files && npm run prerender",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -b",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "audit:lh": "lighthouse http://localhost:4173 --preset=desktop --output=json --output=html --output-path=./lighthouse/report --chrome-flags=\"--headless=new\" --quiet",
    "seo:files": "node scripts/generate-llms.mjs",
    "prerender": "npm run prerender:browser && node scripts/prerender.mjs",
    "prerender:browser": "puppeteer browsers install chrome"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-intersection-observer": "^9.13.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "lighthouse": "^13.4.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "puppeteer": "^25.9.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
